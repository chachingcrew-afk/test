# Local testing only. On GitHub these go into Settings > Secrets and variables > Actions.

# Residential proxy, in the format your provider's dashboard shows:
# http://USERNAME:PASSWORD@HOST:PORT
PROXY_URL=

# csv | supabase | csv,supabase
STORAGE_BACKENDS=csv

# Only needed once you switch to Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
