{
  "proxy": {
    "enabled": true,
    "host": "p.webshare.io",
    "port": 80,
    "country": "nl",
    "rotate": true,
    "username": "YOUR_WEBSHARE_USERNAME",
    "password": "YOUR_WEBSHARE_PASSWORD",
    "mode": "fallback"
  },
  "supabase": {
    "url": "https://xxxxxxxx.supabase.co",
    "key": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
  },
  "settings": {
    "timeout": 20,
    "products_file": "products.xlsx",
    "max_retries": 2,
    "delay_min": 1.5,
    "delay_max": 4.0,
    "max_mb_per_run": 200,
    "research_not_found_after_days": 14,
    "max_minutes_per_run": 100,
    "browser_fallback": true,
    "sitemap_max_mb_paid": 50
  }
}
